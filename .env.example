# Browser: public configuration only
VITE_SUPABASE_URL=https://YOUR_PROJECT.example
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
# Server: runtime secret storage in production; never prefix secrets with VITE_
SUPABASE_URL=https://YOUR_PROJECT.example
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
ANTHROPIC_API_KEY=YOUR_SERVER_ONLY_ANTHROPIC_KEY